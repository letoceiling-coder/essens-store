<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Если запрос идет к API или другим маршрутам Laravel
    # И это не существующий файл или директория
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # И запрос не начинается с /public/
    RewriteCond %{REQUEST_URI} !^/public/
    
    # Перенаправляем в public директорию
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>


